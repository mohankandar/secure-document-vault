{
  "name": "sdv-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --dir src",
    "test:e2e": "playwright test",
    "ui:capture": "playwright test e2e/sdv-screen-tour.spec.ts",
    "ui:steps": "playwright test e2e/sdv-screen-tour.spec.ts -g",
    "ui:smoke": "playwright test e2e/sdv-screen-tour.spec.ts --project=desktop-chromium -g \"(Business User|Document Steward|Business Administrator|IT Administrator|Platform Operations Administrator) screens|no-access page|Without a session\"",
    "ui:capture:headed": "playwright test e2e/sdv-screen-tour.spec.ts --headed",
    "ui:report": "playwright show-report",
    "ui:compare": "playwright test e2e/ui-compare.spec.ts --project=desktop-chromium"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.7.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}

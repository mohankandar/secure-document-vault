{
  "name": "sdv-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "playwright test",
    "ui:capture": "playwright test e2e/sdv-screen-tour.spec.ts",
    "ui:capture:headed": "playwright test e2e/sdv-screen-tour.spec.ts --headed",
    "ui:report": "playwright show-report"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "5.4.14"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sdv.platform</groupId>
    <artifactId>sdv-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SDV Backend</name>

    <modules>
        <module>sdv-domain</module>
        <module>sdv-application</module>
        <module>sdv-persistence</module>
        <module>sdv-security</module>
        <module>sdv-storage</module>
        <module>sdv-audit</module>
        <module>sdv-local</module>
        <module>sdv-web</module>
        <module>sdv-setup</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Task 0067: which licence keys the build trusts; only a developer's build says development. -->
        <licence.build>release</licence.build>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <platform.core.version>1.3.0</platform.core.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.2.0</spring-boot.version>
        <maven.compiler.version>3.14.1</maven.compiler.version>
        <maven.surefire.version>3.5.6</maven.surefire.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <!-- Task 0070: Liquibase 5 has another licence (plan 0059, question 1). -->
        <liquibase.version>4.33.0</liquibase.version>
    </properties>

    <repositories>
        <!-- platform-core releases on GitHub Packages. Credentials come from server id
             github-platform-core: ~/.m2/settings.xml locally, .github/maven-settings.xml in CI
             (docs/install/PLATFORM_PACKAGES.md). -->
        <repository>
            <id>github-platform-core</id>
            <url>https://maven.pkg.github.com/mohankandar/platform-core</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.documentplatform.platform</groupId>
                <artifactId>platform-bom</artifactId>
                <version>${platform.core.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Task 0086: Test-SDV-SchemaUpgrade.ps1 runs the PostgreSQL-only tests in several processes, each on its own copy
             of the checked scratch database (it.url_1, it.url_2, ...). -->
        <profile>
            <id>postgres-copies</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <forkCount>${it.forks}</forkCount>
                                <reuseForks>true</reuseForks>
                                <environmentVariables>
                                    <SDV_IT_JDBC_URL>${it.url}_${surefire.forkNumber}</SDV_IT_JDBC_URL>
                                </environmentVariables>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

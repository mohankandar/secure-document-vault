<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sdv.platform</groupId>
    <artifactId>sdv-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SDV Backend</name>

    <modules>
        <module>sdv-domain</module>
        <module>sdv-application</module>
        <module>sdv-persistence</module>
        <module>sdv-security</module>
        <module>sdv-storage</module>
        <module>sdv-crypto</module>
        <module>sdv-audit</module>
        <module>sdv-local</module>
        <module>sdv-web</module>
        <module>sdv-setup</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <platform.core.version>0.6.1</platform.core.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <maven.compiler.version>3.14.1</maven.compiler.version>
        <maven.surefire.version>3.5.6</maven.surefire.version>
        <pdfbox.version>3.0.8</pdfbox.version>
    </properties>

    <repositories>
        <!-- platform-core releases on GitHub Packages. Credentials come from server id
             github-platform-core: ~/.m2/settings.xml locally, .github/maven-settings.xml in CI
             (docs/install/PLATFORM_PACKAGES.md). -->
        <repository>
            <id>github-platform-core</id>
            <url>https://maven.pkg.github.com/mohankandar/platform-core</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Task 0058: security override. Spring Boot 3.5.16 pins httpclient5 5.5.2 and httpcore5 5.3.6, which have
                 CVE-2026-64607, CVE-2026-54399 and CVE-2026-54428. platform-core 0.6.1 is built on httpclient5 5.6.5
                 and httpcore5 5.4.4 and its release notes ask apps to override. Spring Boot is imported as a BOM, so
                 its version properties can't be set here; these entries win over the imported BOMs instead.
                 Remove the override once Spring Boot's own versions are newer than these. -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>5.6.5</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>5.4.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>5.4.4</version>
            </dependency>
            <dependency>
                <groupId>com.documentplatform.platform</groupId>
                <artifactId>platform-bom</artifactId>
                <version>${platform.core.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

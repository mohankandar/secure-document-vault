<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sdv.platform</groupId>
        <artifactId>sdv-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>sdv-setup</artifactId>
    <name>sdv-setup</name>
    <description>Task 0041: platform-core's setup command for Vero, as one runnable jar for the setup wrapper (setup.ps1,
        setup.cmd, setup.sh). It loads the licence, customer, entities, login connection, group grants and client
        bindings into Vero's database. Never on the app's classpath (owner answer 16).</description>

    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-setup</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.documentplatform.setup.SetupCommand</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
